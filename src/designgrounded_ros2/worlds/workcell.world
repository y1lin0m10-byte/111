<?xml version="1.0"?>
<sdf version="1.6">
  <world name="designgrounded_workcell">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <model name="work_table">
      <static>true</static>
      <pose>0 0 0.05 0 0 0</pose>
      <link name="table">
        <visual name="top">
          <geometry><box><size>1.10 0.70 0.10</size></box></geometry>
          <material>
            <ambient>0.25 0.28 0.32 1</ambient>
            <diffuse>0.36 0.40 0.45 1</diffuse>
          </material>
        </visual>
        <collision name="top">
          <geometry><box><size>1.10 0.70 0.10</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="assembly_base">
      <static>true</static>
      <pose>0 0 0.105 0 0 0</pose>
      <link name="base">
        <visual name="visual">
          <geometry><box><size>0.82 0.22 0.012</size></box></geometry>
          <material>
            <ambient>0.20 0.22 0.24 1</ambient>
            <diffuse>0.32 0.35 0.38 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.82 0.22 0.012</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="staging_tray">
      <static>true</static>
      <pose>0.29 0.18 0.106 0 0 0</pose>
      <link name="tray">
        <visual name="visual">
          <geometry><box><size>0.60 0.22 0.012</size></box></geometry>
          <material>
            <ambient>0.35 0.22 0.10 1</ambient>
            <diffuse>0.48 0.30 0.13 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.60 0.22 0.012</size></box></geometry>
        </collision>
      </link>
    </model>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>30</update_rate>
    </plugin>
  </world>
</sdf>

